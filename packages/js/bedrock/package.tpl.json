{
  "name": "@nlux-dev/bedrock",
  "version": "{versions.nlux}",
  "license": "SEE LICENSE IN ROOT LICENSE FILE",
  "scripts": {
    "build": "rollup --config rollup.config.ts --configPlugin 'typescript={moduleResolution: \"bundler\"}'",
    "watch": "rollup --config rollup.config.ts --configPlugin 'typescript={moduleResolution: \"bundler\"}' --watch"
  },
  "dependencies": {
    "@nlux/core": "{versions.nlux}",
    "@aws-sdk/client-bedrock-runtime": "^{versions.dependencies.bedrock}"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@rollup/plugin-commonjs": "{versions.devDependencies.@rollup/plugin-commonjs}",
    "@rollup/plugin-node-resolve": "{versions.devDependencies.@rollup/plugin-node-resolve}",
    "@rollup/plugin-replace": "{versions.devDependencies.@rollup/plugin-replace}",
    "@rollup/plugin-strip": "{versions.devDependencies.@rollup/plugin-strip}",
    "@rollup/plugin-terser": "{versions.devDependencies.@rollup/plugin-terser}",
    "@rollup/plugin-typescript": "{versions.devDependencies.@rollup/plugin-typescript}",
    "@rollup/plugin-alias": "{versions.devDependencies.@rollup/plugin-alias}",
    "@rollup/plugin-json": "^6",
    "rollup": "{versions.devDependencies.rollup}",
    "rollup-plugin-dts": "{versions.devDependencies.rollup-plugin-dts}",
    "rollup-plugin-esbuild": "{versions.devDependencies.rollup-plugin-esbuild}",
    "tslib": "{versions.devDependencies.tslib}"
  },
  "main": "index.js",
  "types": "bedrock.d.ts",
  "module": "esm/bedrock.js",
  "browser": "umd/bedrock.js"
}
