{
  "name": "@nlux/monorepo",
  "version": "latest",
  "description": "NLUX is a JavaScript and React library for building conversational AI experiences.",
  "author": "Salmen Hichri",
  "license": "SEE LICENSE IN ROOT LICENSE FILE",
  "homepage": "https://docs.nlkit.com/nlux",
  "private": true,
  "workspaces": [
    "packages/js/core",
    "packages/react/core",
    "packages/js/nlbridge",
    "packages/react/nlbridge",
    "packages/js/langchain",
    "packages/react/langchain",
    "packages/js/openai",
    "packages/react/openai",
    "packages/js/hf",
    "packages/react/hf",
    "packages/js/bedrock",
    "packages/react/bedrock",
    "packages/extra/highlighter",
    "packages/extra/markdown",
    "packages/css/themes",
    "dist/dev/nlux-core",
    "dist/dev/nlux-react",
    "dist/dev/nlbridge",
    "dist/dev/nlbridge-react",
    "dist/dev/langchain",
    "dist/dev/langchain-react",
    "dist/dev/openai",
    "dist/dev/openai-react",
    "dist/dev/hf",
    "dist/dev/hf-react",
    "dist/dev/bedrock",
    "dist/dev/bedrock-react",
    "dist/dev/highlighter",
    "dist/dev/markdown",
    "dist/dev/themes",
    "docs",
    "specs"
  ],
  "scripts": {
    "generate": "node pipeline/scripts/generate.mjs",
    "preinstall": "node pipeline/scripts/check-workspaces.mjs",
    "cleanup": "node pipeline/scripts/cleanup.mjs",
    "set": "node pipeline/scripts/set.mjs",
    "reset": "yarn run cleanup && yarn run build:dev",
    "build": "node pipeline/scripts/build.mjs",
    "dev": "node pipeline/scripts/dev.mjs",
    "build-demo": "tsc --project examples/baseline/tsconfig.json && vite build examples/baseline --outDir ../../dist/demo",
    "build-docs": "cd docs && yarn run build",
    "watch": "node pipeline/scripts/watch.mjs",
    "test": "node pipeline/scripts/test.mjs",
    "lint": "yarn run eslint . --no-inline-config",
    "build:dev": "node pipeline/scripts/build.mjs development",
    "test:pipeline": "node --test pipeline/tests/*.test.mjs"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "jsdom": "^24",
    "symlink-dir": "^6",
    "typescript": "^5",
    "typescript-eslint": "8.8.1",
    "vite": "^5"
  },
  "bugs": "https://github.com/nlkitai/nlux/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nlkitai/nlux.git"
  },
  "keywords": [
    "nlux",
    "js",
    "llm",
    "large-language-model",
    "convo",
    "ai-chatbot",
    "ai-chat",
    "AiChat",
    "chatgpt",
    "openai",
    "gpt",
    "gpt4",
    "gpt4-turbo",
    "gpt-4o",
    "hugging face",
    "huggingface",
    "transformers",
    "typescript",
    "javascript",
    "react",
    "generative-ai",
    "conversational",
    "conversational-ui",
    "conversational-interface",
    "interface",
    "chatbot",
    "chat",
    "assistant",
    "ai",
    "artificial-intelligence",
    "artificial",
    "intelligence",
    "natural",
    "language",
    "processing",
    "nlp",
    "nlu",
    "nlg",
    "natural",
    "language",
    "natural-language",
    "understanding"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x",
    "yarn": "1.22.22"
  }
}
